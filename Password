
#include <stdio.h>
#include <string.h>
#include <conio.h>

struct Bank
{
    int accountNo;
    char name[50];
    float balance;
};

int main()
{
    // LOGIN AUTHENTICATION

    char username[30];
    char password[10];
    char std_username[] = "D3c2";
    char std_password[] = "272260";

    int ch, p = 0;

    printf("===== LOGIN PAGE =====\n");

    printf("Enter the username: ");
    scanf("%29s", username);

    // PASSWORD MASKING

    printf("Enter the password: ");

    while (1)
    {
        ch = getch();

        if (ch == 13)  // ENTER KEY
        {
            break;
        }
        else if (ch == 8)  // BACKSPACE
        {
            if (p > 0)
            {
                p--;
                printf("\b \b");
            }
        }
        else if (p < 9)
        {
            password[p] = ch;
            p++;
            printf("*");
        }
    }

    password[p] = '\0';

    printf("\n");

    if (strcmp(username, std_username) != 0 ||
        strcmp(password, std_password) != 0)
    {
        printf("\nInvalid username or password!\n");
        return 0;
    }

    printf("\nLogin successful!\n");
    printf("Welcome to Bank Account Management\n");


    // CUSTOMER DETAILS

    char customerName[50];
    char emailID[50];
    char address[100];
    char mobNo[15];
    char dateOfBirth[15];
    char aadharNo[13];
    char occupation[25];
    float income;

    printf("\n===== CUSTOMER DETAILS =====\n");

    printf("Customer Name: ");
    scanf(" %49[^\n]", customerName);

    printf("Email ID: ");
    scanf(" %49[^\n]", emailID);

    printf("Address: ");
    scanf(" %99[^\n]", address);

    printf("Mobile No: ");
    scanf("%14s", mobNo);

    printf("Date of Birth (DD-MM-YYYY): ");
    scanf("%14s", dateOfBirth);

    printf("Aadhar No: ");
    scanf("%12s", aadharNo);

    printf("Occupation: ");
    scanf(" %24[^\n]", occupation);

    printf("Income: ");
    scanf("%f", &income);


    // BANK ACCOUNT MANAGEMENT

    struct Bank customer[100] =
    {
        {101, "Chiranth", 500000},
        {102, "Dhanush Patel", 600000},
        {103, "Chalana", 700000},
        {104, "Divya", 800000},
        {105, "Deepthi", 900000}
    };

    int n = 5;
    int choice, i, pos, accNo;
    float amount;

    struct Bank temp;

    while (1)
    {
        printf("\n===== BANK MANAGEMENT MENU =====\n");
        printf("1. Add New Person\n");
        printf("2. Remove Person\n");
        printf("3. Withdraw Money\n");
        printf("4. Display All Details\n");
        printf("5. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            // CASE 1: ADD NEW PERSON

            case 1:

                if (n >= 100)
                {
                    printf("Bank is full!\n");
                    break;
                }

                printf("Enter Account Number: ");
                scanf("%d", &temp.accountNo);

                for (i = 0; i < n; i++)
                {
                    if (customer[i].accountNo == temp.accountNo)
                    {
                        break;
                    }
                }

                if (i < n)
                {
                    printf("Account already exists!\n");
                    break;
                }

                printf("Enter Customer Name: ");
                scanf(" %49[^\n]", temp.name);

                printf("Enter Opening Balance: ");
                scanf("%f", &temp.balance);

                if (temp.balance < 0)
                {
                    printf("Invalid balance!\n");
                    break;
                }

                printf("Enter Position (1 to %d): ", n + 1);
                scanf("%d", &pos);

                if (pos < 1 || pos > n + 1)
                {
                    printf("Invalid position!\n");
                    break;
                }

                // SHIFT RECORDS TO THE RIGHT

                for (i = n; i >= pos; i--)
                {
                    customer[i] = customer[i - 1];
                }

                customer[pos - 1] = temp;
                n++;

                printf("Member added successfully!\n");

                break;


            // CASE 2: REMOVE PERSON

            case 2:

                printf("Enter Account Number to Remove: ");
                scanf("%d", &accNo);

                for (i = 0; i < n; i++)
                {
                    if (customer[i].accountNo == accNo)
                    {
                        break;
                    }
                }

                if (i == n)
                {
                    printf("Account not found!\n");
                    break;
                }

                // SHIFT RECORDS TO THE LEFT

                for (; i < n - 1; i++)
                {
                    customer[i] = customer[i + 1];
                }

                n--;

                printf("Member removed successfully!\n");

                break;


            // CASE 3: WITHDRAW MONEY

            case 3:

                printf("Enter Account Number: ");
                scanf("%d", &accNo);

                for (i = 0; i < n; i++)
                {
                    if (customer[i].accountNo == accNo)
                    {
                        break;
                    }
                }

                if (i == n)
                {
                    printf("Account not found!\n");
                    break;
                }

                printf("Customer Name: %s\n",
                       customer[i].name);

                printf("Available Balance: Rs. %.2f\n",
                       customer[i].balance);

                printf("Enter Withdrawal Amount: ");
                scanf("%f", &amount);

                if (amount <= 0)
                {
                    printf("Invalid amount!\n");
                }

                else if (amount > customer[i].balance)
                {
                    printf("Insufficient balance!\n");
                }

                else
                {
                    customer[i].balance -= amount;

                    printf("Withdrawal successful!\n");

                    printf("Remaining Balance: Rs. %.2f\n",
                           customer[i].balance);
                }

                break;


            // CASE 4: DISPLAY ALL DETAILS

            case 4:

                printf("\n===== ALL CUSTOMER DETAILS =====\n");

                if (n == 0)
                {
                    printf("No customer records available.\n");
                }

                else
                {
                    for (i = 0; i < n; i++)
                    {
                        printf("\nPosition: %d\n", i + 1);

                        printf("Account Number: %d\n",
                               customer[i].accountNo);

                        printf("Name: %s\n",
                               customer[i].name);

                        printf("Balance: Rs. %.2f\n",
                               customer[i].balance);
                    }
                }

                break;


            // CASE 5: EXIT

            case 5:

                printf("Thank you!\n");

                return 0;


            // INVALID CHOICE

            default:

                printf("Invalid choice!\n");
        }
    }

    return 0;
}
